{
  "name": "blitzcrank",
  "version": "1.0.0",
  "private": true,
  "description": "Blitzcrank gaming gear store — storefront, SQLite database and API",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "db:seed": "node --disable-warning=ExperimentalWarning db/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning db/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
